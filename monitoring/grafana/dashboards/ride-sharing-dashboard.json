{
  "title": "Ride-Sharing Microservices",
  "uid": "ride-sharing-overview",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests per Second (all services)",
      "type": "graph",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate (5xx)",
      "type": "graph",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (application)",
          "legendFormat": "{{application}} errors"
        }
      ]
    },
    {
      "id": 3,
      "title": "Circuit Breaker State (ride-service)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{application=\"ride-service\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Circuit Breaker Calls (ride-service)",
      "type": "graph",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(resilience4j_circuitbreaker_calls_seconds_count[1m])) by (name, kind)",
          "legendFormat": "{{name}} - {{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM Heap Memory Used (MB)",
      "type": "graph",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1024 / 1024",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Avg Response Time (ms)",
      "type": "graph",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum[1m]) / rate(http_server_requests_seconds_count[1m]) * 1000",
          "legendFormat": "{{application}} {{uri}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "RabbitMQ Messages Published",
      "type": "graph",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(spring_rabbitmq_template_published_total[1m])) by (application)",
          "legendFormat": "{{application}} published"
        }
      ]
    }
  ]
}
